---
const pages = import.meta.glob('./*.md', { eager: true });
const tools = Object.entries(pages).map(([path, page]) => ({
  title: page.frontmatter.title,
  description: page.frontmatter.description ?? '',
  order: page.frontmatter.order ?? 999,
  href: '/' + path.split('/').pop().replace(/\.md$/, '/') ,
})).sort((a,b) => a.order - b.order || a.title.localeCompare(b.title, 'cs'));
---
<!doctype html>
<html lang="cs">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="Praktická inspirace do výuky a stručné návody k nástrojům Živé tabule." />
<title>Tipy pro Živou tabuli</title>
<style>
:root{font-family:system-ui,sans-serif;color:#143a33;background:#f5f7f4}
*{box-sizing:border-box}body{max-width:900px;margin:0 auto;padding:2rem 1rem;line-height:1.6}
a{color:#125a52}header{margin-bottom:2rem}h1{font-size:2rem;line-height:1.2}
.catalog{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem}
.card{display:block;padding:1.2rem;background:#ffffff;border:1px solid transparent;border-radius:22px;text-decoration:none;color:#204a52}
.card:hover{background:#edf4ef}.card:focus-visible{outline:2px solid #145b56;outline-offset:3px}.card h2{margin:0 0 .5rem;border:0;padding:0}.card h2::after{content:none;display:none}.card p{margin:0}
footer{margin-top:3rem;font-size:.9rem;color:#42645b}
</style>
</head>
<body>
<header><p><a href="https://zivatabule.cz">← Živá tabule</a></p><h1>Tipy pro Živou tabuli</h1><p>Živá tabule nabízí nástroje. Tady najdete konkrétní nápady, jak s nimi učit – a krátké návody, abyste mohli rovnou začít.</p></header>
<main><div class="catalog">{tools.map(tool => <a class="card" href={tool.href}><h2>{tool.title}</h2><p>{tool.description}</p></a>)}</div></main>
<footer>Živá tabule · Bez účtu. Bez reklam. Bez sledování.</footer>
</body></html>
